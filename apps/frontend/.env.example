# API base URL used by the frontend HTTP client.
# In development, Vite proxies /api to the backend (see vite.config.ts).
VITE_API_BASE_URL=/api/v1

# Clerk publishable key — get this from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Admin email — this user is always treated as ADMIN regardless of backend
VITE_ADMIN_EMAIL=admin@example.com
